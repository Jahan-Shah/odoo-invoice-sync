<odoo>
  <record id="action_report_recon" model="ir.actions.report">
    <field name="name">Reconciliation Report</field>
    <field name="model">sync.invoice</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">invoice_sync.report_recon</field>
    <field name="report_file">invoice_sync.report_recon</field>
    <field name="binding_model_id" ref="model_sync_invoice"/>
    <field name="binding_type">report</field>
  </record>

  <template id="report_recon">
    <t t-call="web.html_container">
      <div class="page" style="padding: 20px;">
        <h2>Invoice Reconciliation Report</h2>
        <p>Records: <t t-out="len(docs)"/></p>
        <table class="table table-sm">
          <thead>
            <tr>
              <th>External ID</th><th>Client</th><th>Date</th>
              <th class="text-end">Amount</th>
              <th class="text-end">Ledger</th>
              <th class="text-end">Difference</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            <tr t-foreach="docs" t-as="r">
              <td><t t-out="r.external_id"/></td>
              <td><t t-out="r.partner_name"/></td>
              <td><t t-out="r.invoice_date"/></td>
              <td class="text-end"><t t-out="'%.2f' % r.amount"/></td>
              <td class="text-end"><t t-out="'%.2f' % r.ledger_amount"/></td>
              <td class="text-end"><t t-out="'%.2f' % (r.amount - r.ledger_amount)"/></td>
              <td><t t-out="r.recon_state"/></td>
            </tr>
          </tbody>
          <tfoot>
            <tr>
              <th colspan="3">Totals</th>
              <th class="text-end"><t t-out="'%.2f' % sum(docs.mapped('amount'))"/></th>
              <th class="text-end"><t t-out="'%.2f' % sum(docs.mapped('ledger_amount'))"/></th>
              <th class="text-end"><t t-out="'%.2f' % (sum(docs.mapped('amount')) - sum(docs.mapped('ledger_amount')))"/></th>
              <th/>
            </tr>
          </tfoot>
        </table>
      </div>
    </t>
  </template>
</odoo>
